@import "tailwindcss" source(none);
@source "../src";
@import "tw-animate-css";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
  --radius-2xl: calc(var(--radius) + 8px);
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-muted: var(--muted);
  --color-accent: var(--accent);
  --color-border: var(--border);
  --color-ring: var(--ring);
  --font-sans: "Inter", system-ui, sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, monospace;
  --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
}

:root {
  --radius: 0.75rem;
  --background: hsl(40 20% 98%);
  --foreground: hsl(150 20% 12%);
  --primary: hsl(142 76% 18%);       /* verde profundo */
  --primary-foreground: hsl(40 20% 98%);
  --secondary: hsl(150 10% 95%);
  --muted: hsl(150 10% 40%);
  --accent: hsl(38 92% 50%);          /* âmbar p/ alertas */
  --destructive: hsl(0 70% 45%);
  --border: hsl(150 15% 12% / 0.1);
  --ring: hsl(142 76% 18%);
}

@keyframes slide-in {
  from { transform: translateY(10px); opacity: 0; }
  to   { transform: translateY(0);    opacity: 1; }
}
.animate-fade-in { animation: slide-in 0.6s var(--ease-out-expo) both; }

@layer base {
  * { border-color: var(--color-border); }
  body {
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }
}
